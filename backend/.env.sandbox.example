APP_ENV=sandbox

# Supabase sandbox project
SUPABASE_URL=https://your-sandbox-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_sandbox_supabase_service_role_key

# CORS / frontend
FRONTEND_URL=https://your-sandbox.vercel.app
FRONTEND_URLS=http://localhost:5173,https://your-sandbox.vercel.app

# Sandbox admin / ops users seeded by backend/scripts/seed_sandbox_data.py
SYSTEM_ADMIN_EMAILS=system_admin@palfish.vn
OPS_EMAILS=manager@palfish.vn

# PayOS sandbox only. Leave blank to force bank-simulate/mock testing.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=https://your-render-sandbox.onrender.com/webhook/payos

# DingTalk outbound isolation.
# Do not put the production webhook here in sandbox.
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL_SANDBOX=

# Optional integrations for sandbox CRM / Google Sheets tests.
METABASE_BASE_URL=
METABASE_EMAIL=
METABASE_PASSWORD=
METABASE_PACKAGES_QUESTION_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
