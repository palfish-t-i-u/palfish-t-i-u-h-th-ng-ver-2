{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "VITE_API_BASE_URL": "/api"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://palfish-gmv-api.onrender.com/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
